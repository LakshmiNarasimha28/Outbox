# ==============================================================
# Outbox Labs Email Job Scheduler - Environment Variables Example
# Duplicate this file as .env in backend/ or root to configure.
# DO NOT COMMIT REAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration (Dedicated outbox_app Account)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=outbox_app
DB_PASSWORD=your_outbox_app_password
DB_NAME=outbox_scheduler
DB_CONNECTION_LIMIT=10

# Redis / BullMQ Configuration
# For Hosted Redis (e.g. Upstash, Aiven, Redis Cloud), supply REDIS_URL or discrete settings:
# REDIS_URL=rediss://default:your_redis_password@your-hosted-redis.com:6379
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_TLS=true
REDIS_DB=0

# Ethereal SMTP Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
DEFAULT_SENDER=scheduler@outbox.labs

# Worker Concurrency & Local Throttling
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=200

# Distributed Hourly Rate Limiting (Redis-backed atomic sliding window)
HOURLY_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=3600000

# Elasticsearch Search Engine Configuration
# For local Docker: http://localhost:9200
# For Elastic Cloud or managed cluster: https://your-deployment.es.io:9243
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=email_jobs
# Leave blank for unauthenticated local clusters, or supply credentials:
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
# Alternatively, use an API key instead of basic auth:
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000

# Google OAuth 2.0 & Session Configuration
# Obtain credentials from https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI must match GOOGLE_CALLBACK_URL (e.g. http://localhost:5000/api/auth/google/callback)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
SESSION_SECRET=your_random_32_character_session_signing_secret
# Set to true to strictly require authentication on email endpoints:
AUTH_ENFORCED=false

# Slack OAuth v2 & Hourly Rate-Limit Alert Configuration
# Obtain credentials from https://api.slack.com/apps
# Required Bot Scopes: incoming-webhook, chat:write
# Authorized Redirect URI: http://localhost:5000/api/auth/slack/callback
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_CALLBACK_URL=http://localhost:5000/api/auth/slack/callback
SLACK_NOTIFICATION_COOLDOWN_SECONDS=900
# Optional 32-byte hex key for token encryption at rest (defaults to SHA-256 of SESSION_SECRET)
ENCRYPTION_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000
