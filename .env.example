# ==============================================================
# Outbox Labs Email Job Scheduler - Environment Variables Example
# Duplicate this file as .env in backend/ or root to configure.
# DO NOT COMMIT REAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration (Dedicated outbox_app Account)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=outbox_app
DB_PASSWORD=your_outbox_app_password
DB_NAME=outbox_scheduler
DB_CONNECTION_LIMIT=10

# Redis / BullMQ Configuration
# For Hosted Redis (e.g. Upstash, Aiven, Redis Cloud), supply REDIS_URL or discrete settings:
# REDIS_URL=rediss://default:your_redis_password@your-hosted-redis.com:6379
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_TLS=true
REDIS_DB=0

# Ethereal SMTP Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
DEFAULT_SENDER=scheduler@outbox.labs

# Worker Concurrency & Local Throttling
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=200

# Distributed Hourly Rate Limiting (Redis-backed atomic sliding window)
HOURLY_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=3600000

# Elasticsearch Search Engine Configuration
# For local Docker: http://localhost:9200
# For Elastic Cloud or managed cluster: https://your-deployment.es.io:9243
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=email_jobs
# Leave blank for unauthenticated local clusters, or supply credentials:
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
# Alternatively, use an API key instead of basic auth:
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000
